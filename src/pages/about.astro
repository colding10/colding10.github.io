---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
---

<Layout class="max-w-3xl">
	<PageHead slot="head" title="About" />
	<Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

	<section class="space-y-8">
		<!-- Hero Section -->
		<div class="flex items-center gap-6">
			<img
				src="/static/logo.png"
				alt="Profile picture of cold"
				class="ring-border size-24 shrink-0 rounded-full ring-2"
				loading="lazy"
				decoding="async"
			/>
			<div class="space-y-4">
				<h1 class="font-serif text-4xl font-bold">About Me</h1>
				<p>
					Hi, I'm <b>cold</b>; I play CTFs, write code, and
					break things for fun.
				</p>
			</div>
		</div>

		<!-- About Text -->
		<div class="prose prose-lg space-y-6">
			<p>
				In CTF I lean toward reverse engineering, misc, and OSINT,
				and I'll take on most other categories too (except pwn). I've
				spent more time than I should have staring at
				<Link href="https://hex-rays.com/" external>IDA</Link> and <Link
					href="https://github.com/pwndbg/pwndbg"
					external>pwndbg</Link
				>, and I keep a 1TB external SSD full of challenge files and
				VM images with assorted toolchains on it. I play with <Link
					href="https://ctftime.org/team/222966"
					external>Squid Proxy Lovers</Link
				> most of the time, but I also duo with <Link
					href="https://tienxion.github.io"
					external>tien</Link
				> and compete with <Link
					href="https://ctftime.org/team/372043/"
					external>Cosmic Bit Flip</Link
				>. You can find everything I've played <Link href="/history"
					>here</Link
				>.
			</p>

			<p>
				The blog is where I put writeups and other technical posts
				when something feels worth writing about.
			</p>
		</div>

		<!-- Contact -->
		<div class="space-y-4">
			<p class="text-foreground/70">
				DM me on Discord <b>@cold10</b> if you want to reach out;
				GitHub and other socials are at the bottom of the page.
			</p>
			<div class="flex gap-3">
				<Link
					href="https://github.com/colding10"
					class="border-border bg-background hover:bg-accent hover:text-accent-foreground inline-flex h-9 items-center justify-center gap-2 rounded-md border px-4 py-2 text-sm font-medium whitespace-nowrap shadow-xs transition-colors"
					external
				>
					<Icon name="lucide:github" class="size-4" />
					GitHub
				</Link>
				<Link
					href="/history"
					class="border-border bg-background hover:bg-accent hover:text-accent-foreground inline-flex h-9 items-center justify-center gap-2 rounded-md border px-4 py-2 text-sm font-medium whitespace-nowrap shadow-xs transition-colors"
				>
					<Icon name="lucide:trophy" class="size-4" />
					CTF History
				</Link>
			</div>
		</div>
	</section>
</Layout>
